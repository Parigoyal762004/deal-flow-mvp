{
  "name": "Deal Flow — 1. Intake & AI Analysis",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deal-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook — Deal Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "deal-intake"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, dealId: $json.dealId }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Respond — Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 160]
    },
    {
      "parameters": {
        "jsCode": "// Validate webhook secret\nconst secret = $input.first().json.headers['x-webhook-secret'];\nconst expected = $env['N8N_WEBHOOK_SECRET'];\nif (secret !== expected) {\n  throw new Error('Unauthorized: invalid webhook secret');\n}\n\nconst body = $input.first().json.body;\nreturn [{\n  json: {\n    dealId: body.dealId,\n    approvalToken: body.approvalToken,\n    appUrl: body.appUrl,\n    startupName: body.startupName,\n    founderName: body.founderName,\n    founderEmail: body.founderEmail,\n    pitchDeckUrl: body.pitchDeckUrl,\n    websiteUrl: body.websiteUrl || '',\n    linkedinUrl: body.linkedinUrl || '',\n    industry: body.industry || '',\n    stage: body.stage || '',\n    source: body.source || 'Backrr',\n    notes: body.notes || '',\n    additionalLinks: body.additionalLinks || [],\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Code — Validate & Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.pitchDeckUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "HTTP — Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Encode binary PDF to base64 for Claude's document API\nconst binaryData = $input.first().binary;\nconst binaryKey = Object.keys(binaryData)[0];\nconst buffer = Buffer.from(binaryData[binaryKey].data, 'base64');\nconst base64Pdf = buffer.toString('base64');\n\n// Pass through deal metadata alongside the encoded PDF\nconst meta = $input.first().json;\nreturn [{\n  json: {\n    ...meta,\n    pdfBase64: base64Pdf,\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Code — Encode PDF Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "x-api-key",
              "value": "={{ $credentials.httpHeaderAuth.value }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "model": "claude-sonnet-4-6",
          "max_tokens": 2048,
          "system": "You are an expert venture capital analyst at Akro Ventures. You analyze startup pitch decks and draft professional, warm investor response emails. Be concise, insightful, and encouraging while maintaining professional standards.",
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "document",
                  "source": {
                    "type": "base64",
                    "media_type": "application/pdf",
                    "data": "={{ $json.pdfBase64 }}"
                  },
                  "title": "={{ $json.startupName }} — Pitch Deck"
                },
                {
                  "type": "text",
                  "text": "Startup: {{ $json.startupName }}\nFounder: {{ $json.founderName }} ({{ $json.founderEmail }})\nIndustry: {{ $json.industry }}\nStage: {{ $json.stage }}\nSource: {{ $json.source }}\nWebsite: {{ $json.websiteUrl }}\nNotes from our team: {{ $json.notes }}\n\nPlease provide your response in this EXACT JSON format (no markdown, pure JSON):\n{\n  \"summary\": \"3-4 sentence executive summary of the startup\",\n  \"strengths\": [\"strength 1\", \"strength 2\", \"strength 3\"],\n  \"risks\": [\"risk 1\", \"risk 2\"],\n  \"investment_thesis\": \"1-2 sentence assessment of the investment opportunity\",\n  \"draft_email\": \"The complete professional email to send to {{ $json.founderName }} at {{ $json.startupName }}. Start with Dear {{ $json.founderName }}, and sign off as The Akro Ventures Team. The email should: thank them for sharing the deck, acknowledge 1-2 specific things from the deck, explain our investment thesis briefly, and clearly state next steps (schedule a call or pass). Keep it under 200 words.\"\n}"
                }
              ]
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "HTTP — Claude API Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's response and extract structured fields\nconst claudeResponse = $input.first().json;\nconst meta = $('Code — Validate & Extract').first().json;\n\nlet analysisText = '';\ntry {\n  analysisText = claudeResponse.content[0].text;\n} catch (e) {\n  throw new Error('Unexpected Claude response shape: ' + JSON.stringify(claudeResponse));\n}\n\nlet analysis;\ntry {\n  // Claude may wrap in ```json ... ``` fences — strip them\n  const cleaned = analysisText.replace(/^```json\\s*/i, '').replace(/\\s*```$/, '').trim();\n  analysis = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback: treat entire response as draft email\n  analysis = {\n    summary: 'AI analysis unavailable — review pitch deck manually.',\n    strengths: [],\n    risks: [],\n    investment_thesis: '',\n    draft_email: analysisText,\n  };\n}\n\nconst aiSummary = [\n  analysis.summary,\n  analysis.strengths?.length ? '\\n\\n**Strengths:**\\n' + analysis.strengths.map(s => '• ' + s).join('\\n') : '',\n  analysis.risks?.length ? '\\n\\n**Risks:**\\n' + analysis.risks.map(r => '• ' + r).join('\\n') : '',\n  analysis.investment_thesis ? '\\n\\n**Thesis:** ' + analysis.investment_thesis : '',\n].join('');\n\nreturn [{\n  json: {\n    ...meta,\n    aiSummary,\n    draftEmail: analysis.draft_email,\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "Code — Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env['SUPABASE_URL'] }}/rest/v1/deals?id=eq.{{ $json.dealId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env['SUPABASE_SERVICE_ROLE_KEY'] }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env['SUPABASE_SERVICE_ROLE_KEY'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "ai_summary": "={{ $json.aiSummary }}",
          "draft_email": "={{ $json.draftEmail }}",
          "email_status": "awaiting_approval"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "HTTP — Supabase Update Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build the HTML approval email\nconst d = $('Code — Parse Claude Response').first().json;\nconst approveUrl = `${d.appUrl}/api/approve?token=${d.approvalToken}&action=approve`;\nconst rejectUrl  = `${d.appUrl}/api/approve?token=${d.approvalToken}&action=reject`;\nconst dashUrl    = `${d.appUrl}/dashboard`;\n\nconst additionalLinksHtml = d.additionalLinks?.length\n  ? d.additionalLinks.map(l => `<a href=\"${l.url}\" style=\"color:#4c6ef5;\">${l.label}</a>`).join(' · ')\n  : 'None';\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>Deal Review: ${d.startupName}</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;padding:40px 20px;\">\n<tr><td align=\"center\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden;\">\n\n<!-- Header -->\n<tr><td style=\"background:#1e3a8a;padding:28px 36px;\">\n  <p style=\"margin:0;color:#93c5fd;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;\">Akro Ventures · Deal Flow</p>\n  <h1 style=\"margin:8px 0 0;color:#ffffff;font-size:22px;font-weight:700;\">New Deal Review Required</h1>\n  <p style=\"margin:6px 0 0;color:#bfdbfe;font-size:14px;\">${d.startupName} · ${d.stage?.replace('-',' ')} · ${d.industry}</p>\n</td></tr>\n\n<!-- Metadata -->\n<tr><td style=\"padding:28px 36px 0;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n  <tr>\n    <td width=\"50%\" style=\"padding-bottom:16px;\">\n      <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Founder</p>\n      <p style=\"margin:4px 0 0;font-size:14px;color:#0f172a;font-weight:500;\">${d.founderName}</p>\n      <p style=\"margin:2px 0 0;font-size:13px;color:#64748b;\">${d.founderEmail}</p>\n    </td>\n    <td width=\"50%\" style=\"padding-bottom:16px;\">\n      <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Source</p>\n      <p style=\"margin:4px 0 0;font-size:14px;color:#0f172a;font-weight:500;\">${d.source}</p>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding-bottom:16px;\">\n      <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Links</p>\n      <p style=\"margin:4px 0 0;font-size:13px;\">${d.websiteUrl ? `<a href=\"${d.websiteUrl}\" style=\"color:#4c6ef5;\">Website</a>` : ''} ${d.linkedinUrl ? `· <a href=\"${d.linkedinUrl}\" style=\"color:#4c6ef5;\">LinkedIn</a>` : ''} · <a href=\"${d.pitchDeckUrl}\" style=\"color:#4c6ef5;\">Pitch Deck PDF</a></p>\n    </td>\n    <td style=\"padding-bottom:16px;\">\n      <p style=\"margin:0;font-size:11px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;\">Additional Links</p>\n      <p style=\"margin:4px 0 0;font-size:13px;\">${additionalLinksHtml}</p>\n    </td>\n  </tr>\n  </table>\n</td></tr>\n\n<!-- AI Summary -->\n<tr><td style=\"padding:20px 36px 0;\">\n  <div style=\"background:#f0f4ff;border-left:3px solid #4c6ef5;border-radius:0 8px 8px 0;padding:16px 20px;\">\n    <p style=\"margin:0 0 8px;font-size:12px;font-weight:700;color:#4c6ef5;text-transform:uppercase;letter-spacing:0.06em;\">AI Analysis</p>\n    <p style=\"margin:0;font-size:13px;color:#1e293b;line-height:1.7;white-space:pre-wrap;\">${d.aiSummary.replace(/\\*\\*/g,'')}</p>\n  </div>\n</td></tr>\n\n<!-- Draft Email -->\n<tr><td style=\"padding:20px 36px 0;\">\n  <div style=\"background:#fafafa;border:1px solid #e2e8f0;border-radius:10px;padding:20px;\">\n    <p style=\"margin:0 0 12px;font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:0.06em;\">Draft Email to Founder</p>\n    <p style=\"margin:0;font-size:13px;color:#0f172a;line-height:1.8;white-space:pre-wrap;\">${d.draftEmail}</p>\n  </div>\n</td></tr>\n\n<!-- Approval buttons -->\n<tr><td style=\"padding:28px 36px;\">\n  <p style=\"margin:0 0 16px;font-size:13px;color:#64748b;\">Review the AI draft above and click your decision. You can copy-edit the email before approving in production.</p>\n  <table cellpadding=\"0\" cellspacing=\"0\">\n  <tr>\n    <td style=\"padding-right:12px;\">\n      <a href=\"${approveUrl}\" style=\"display:inline-block;background:#16a34a;color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 28px;border-radius:8px;\">✓ Approve &amp; Send</a>\n    </td>\n    <td>\n      <a href=\"${rejectUrl}\" style=\"display:inline-block;background:#fff;color:#dc2626;text-decoration:none;font-size:14px;font-weight:600;padding:12px 28px;border-radius:8px;border:1.5px solid #dc2626;\">✕ Reject</a>\n    </td>\n  </tr>\n  </table>\n  <p style=\"margin:16px 0 0;font-size:12px;color:#94a3b8;\">Approval links are single-use and expire on use. <a href=\"${dashUrl}\" style=\"color:#4c6ef5;\">View Dashboard</a></p>\n</td></tr>\n\n<!-- Footer -->\n<tr><td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 36px;\">\n  <p style=\"margin:0;font-size:11px;color:#94a3b8;text-align:center;\">Akro Ventures · Automated Deal Flow · This email was generated by AI and requires human approval.</p>\n</td></tr>\n\n</table>\n</td></tr>\n</table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...d,\n    approvalEmailHtml: html,\n    approvalEmailSubject: `[Action Required] Deal Review: ${d.startupName} (${d.stage} · ${d.industry})`,\n  }\n}];"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000009",
      "name": "Code — Build Approval Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env['RESEND_API_KEY'] }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "from": "={{ $env['RESEND_FROM_EMAIL'] }}",
          "to": "={{ $env['APPROVAL_EMAIL_RECIPIENTS'].split(',') }}",
          "subject": "={{ $json.approvalEmailSubject }}",
          "html": "={{ $json.approvalEmailHtml }}"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "HTTP — Send Approval Email (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2000, 300]
    }
  ],
