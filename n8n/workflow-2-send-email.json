{
  "name": "Deal Flow — 2. Send Approved Founder Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-founder-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook — Send Founder Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "send-founder-email"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"queued\": true }",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Respond — Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 160]
    },
    {
      "parameters": {
        "jsCode": "// Validate secret and extract payload\nconst secret = $input.first().json.headers['x-webhook-secret'];\nconst expected = $env['N8N_WEBHOOK_SECRET'];\nif (secret !== expected) {\n  throw new Error('Unauthorized');\n}\n\nconst body = $input.first().json.body;\nreturn [{\n  json: {\n    dealId: body.dealId,\n    founderName: body.founderName,\n    founderEmail: body.founderEmail,\n    startupName: body.startupName,\n    draftEmail: body.draftEmail,\n  }\n}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Code — Validate & Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build the HTML email to the founder\nconst d = $input.first().json;\n\n// Convert plain text draft to simple HTML paragraphs\nconst bodyHtml = d.draftEmail\n  .split('\\n\\n')\n  .map(p => `<p style=\"margin:0 0 16px;font-size:15px;color:#1e293b;line-height:1.7;\">${p.replace(/\\n/g, '<br/>')}</p>`)\n  .join('');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<title>From Akro Ventures</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;padding:40px 20px;\">\n<tr><td align=\"center\">\n<table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:16px;border:1px solid #e2e8f0;overflow:hidden;\">\n\n<!-- Header -->\n<tr><td style=\"background:#1e3a8a;padding:28px 40px;\">\n  <p style=\"margin:0;color:#93c5fd;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;\">Akro Ventures</p>\n</td></tr>\n\n<!-- Body -->\n<tr><td style=\"padding:36px 40px;\">\n  ${bodyHtml}\n</td></tr>\n\n<!-- Footer -->\n<tr><td style=\"background:#f8fafc;border-top:1px solid #e2e8f0;padding:20px 40px;\">\n  <p style=\"margin:0;font-size:11px;color:#94a3b8;\">Akro Ventures · This email was reviewed and approved by a member of our investment team.</p>\n</td></tr>\n\n</table>\n</td></tr>\n</table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    ...d,\n    emailHtml: html,\n    emailSubject: `Akro Ventures — Re: ${d.startupName}`,\n  }\n}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Code — Build Founder Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env['RESEND_API_KEY'] }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "from": "={{ $env['RESEND_FROM_EMAIL'] }}",
          "to": ["={{ $json.founderEmail }}"],
          "subject": "={{ $json.emailSubject }}",
          "html": "={{ $json.emailHtml }}"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "HTTP — Send Email to Founder (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env['SUPABASE_URL'] }}/rest/v1/deals?id=eq.{{ $('Code — Validate & Extract').first().json.dealId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env['SUPABASE_SERVICE_ROLE_KEY'] }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env['SUPABASE_SERVICE_ROLE_KEY'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "email_status": "sent"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "HTTP — Supabase Mark Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook — Send Founder Email": {
      "main": [
