# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Webhook URL for the intake workflow (from n8n)
N8N_INTAKE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/deal-intake
# Webhook URL for the send-email workflow (from n8n)
N8N_SEND_EMAIL_WEBHOOK_URL=https://your-n8n-instance.com/webhook/send-founder-email
# Shared secret to authenticate calls between Next.js and n8n
N8N_WEBHOOK_SECRET=your-strong-random-secret-here

# ─── Internal approval ────────────────────────────────────────────────────────
# Email address(es) that receive the internal approval email (comma-separated)
APPROVAL_EMAIL_RECIPIENTS=team@yourfirm.com,partner@yourfirm.com
# From name shown in internal emails
APPROVAL_EMAIL_FROM_NAME=Akro Deal Flow Bot

# ─── Resend (email provider) ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=deals@yourfirm.com

# Optional: use SMTP instead of Resend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Used inside n8n — add this as a credential there, not here
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
